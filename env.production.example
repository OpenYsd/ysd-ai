# ============================================================
# YSD AI — متغيرات التشغيل الإنتاجي (أسماء فقط — لا تضع أي قيمة هنا)
#
#   انسخه إلى ملف **خارج المستودع** واملأه، ثم:
#   docker compose -f docker-compose.production.yml --env-file /مسار/آمن/env up -d
#
# هذا الملف يُرفَع إلى git بلا قيم عمدًا. الملف المُعبّأ يجب ألا يُرفَع أبدًا:
# .gitignore يُخرج .env* ، و.dockerignore يُخرجه من سياق بناء الصورة.
# ============================================================

# ---------- إلزامية ----------

# ⚠️ تلزم مرّتين — وهذا مصدر خطأ شائع:
#    1) وقت البناء (--build-arg): تُحقَن في حزمة المتصفح.
#    2) هنا وقت التشغيل: lib/env.ts يقرأ process.env[name] ديناميكيًا، وNext.js
#       لا يحقن إلا الوصول الساكن. بدونها يفشل checkEnv، ومع YSD_STRICT_ENV=1
#       يُرفض الإقلاع وترد كل المسارات 500.
#    عامة بطبيعتها: تصل كل زائر أصلًا، والمفتاح anon محكوم بـRLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# سرّ خادمي — الموفر الافتراضي المجاني. لا تمرّره كـbuild-arg أبدًا:
# يبقى في تاريخ الطبقات ويكشفه docker history.
OPENROUTER_API_KEY=

# ---------- اختيارية ----------

# موفر Anthropic (اختياري — النظام لا يعتمد على موفر واحد)
ANTHROPIC_API_KEY=

# رابط التطبيق العام (للروابط المطلقة)
YSD_APP_URL=

# ---------- مضبوطة في compose (لا تحتاج تعبئة) ----------
# YSD_STRICT_ENV=1   رفض الإقلاع إن نقص متغير إلزامي
# YSD_LOW_MEMORY=1   تقليل بصمة نموذج Embeddings المحلي

# ---------- لا تُستخدم في الإنتاج ----------
# SUPABASE_SERVICE_ROLE_KEY — لعامل RAG المستقل فقط (غير مُفعّل). المعالجة
#   request-driven لا تحتاجه، ووجوده يزيد سطح الخطر بلا مقابل.
# YSD_OWNER_EMAIL / YSD_OWNER_PASSWORD — سكربتات QA محليًا فقط.
