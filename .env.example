# ============================================================
# YSD AI — نموذج متغيرات البيئة
# انسخه إلى .env.local واملأ القيم. لا تضع أي سر في NEXT_PUBLIC_*.
# ============================================================

# ==== Supabase (مطلوب) ====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# للعامل المستقل فقط — غير مطلوب في الوضع request-driven الحالي.
# لا يُكشف أبدًا للمتصفح ولا يوضع في NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==== موفرو الذكاء الاصطناعي ====
OPENROUTER_API_KEY=          # مطلوب — الموفر الافتراضي المجاني (ysd/free)
ANTHROPIC_API_KEY=           # اختياري — عند توفر رصيد

# ==== إعدادات عامة ====
NEXT_PUBLIC_APP_NAME=YSD AI
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# ==== تشغيل/نشر (اختياري) ====
# YSD_LOW_MEMORY=1           # وضع الذاكرة المنخفضة (خوادم ≤ 2GB)
# YSD_STRICT_ENV=1           # يوقف الإقلاع عند نقص متغير مطلوب (إنتاج)
