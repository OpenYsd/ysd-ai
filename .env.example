# ============================================================
# YSD AI — نموذج متغيرات البيئة
# انسخه إلى .env.local واملأ القيم. لا تضع أي سر في NEXT_PUBLIC_*.
# ============================================================

# ==== Supabase (مطلوب) ====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# ==== موفرو الذكاء الاصطناعي ====
OPENROUTER_API_KEY=          # مطلوب — الموفر الافتراضي المجاني (ysd/free)
ANTHROPIC_API_KEY=           # اختياري — عند توفر رصيد

# ==== إعدادات عامة ====
NEXT_PUBLIC_APP_NAME=YSD AI
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# العنوان العام للمنصّة — **مطلوب**: منه وحده تُبنى تحويلات الوسيط.
# لماذا لا يُشتقّ من الطلب: خلف وكيل Railway يعكس request.url عنوان الربط
# الداخلي (0.0.0.0 والمنفذ المحقون)، وx-forwarded-host يتحكّم به العميل.
# بلا بادئة NEXT_PUBLIC: لا يحتاجه المتصفح.
# محليًا: http://localhost:3000
APP_ORIGIN=https://YOUR-APP.up.railway.app

# ==== تشغيل/نشر (اختياري) ====
# YSD_LOW_MEMORY=1           # وضع الذاكرة المنخفضة (خوادم ≤ 2GB)
# YSD_STRICT_ENV=1           # يوقف الإقلاع عند نقص متغير مطلوب (إنتاج)

# مفتاح خدمة Supabase — خادمي فقط (كتابة observability_events).
# بلا بادئة NEXT_PUBLIC إطلاقًا، ولا تضع القيمة الحقيقية في Git.
# غيابه لا يعطّل المحادثة: المقاييس تعود إلى ذاكرة الخادم.
SUPABASE_SERVICE_ROLE_KEY=

# YSD Browser Assistant access tokens - backend only.
# Required for /api/browser/v1/auth/token. Use at least 32 random bytes.
# Example generator: openssl rand -hex 32
YSD_BROWSER_TOKEN_SECRET=

# ============================================================
# 9Router — مزوّد متوافق مع OpenAI (v0.8.0، تجريبي)
# مغلق افتراضيًا: بلا NINE_ROUTER_ENABLED=1 لا يُهيّأ ولا يظهر ولا يُنادى.
# كلها **خادمية**: لا NEXT_PUBLIC لأيٍّ منها إطلاقًا، ولا تضع قيمًا حقيقية هنا.
# العنوان يُقرأ من البيئة وحدها (لا من إدخال مستخدم) — حارس SSRF.
# 9Router المحلي يجب أن يرتبط بـ127.0.0.1 لا 0.0.0.0.
# ============================================================
NINE_ROUTER_ENABLED=0
NINE_ROUTER_BASE_URL=
NINE_ROUTER_API_KEY=
NINE_ROUTER_DEFAULT_MODEL=
NINE_ROUTER_MODELS_CACHE_SECONDS=300

# ---- مفتاح HMAC لحدّ المعدّل (v0.8.1) — مطلوب ----
# يُهشَّم به مفتاح كل عدّاد حدّ (عنوان IP · البريد · كود الدعوة) قبل أن يصل
# القاعدة. لازمٌ لأن العنوان والبريد **منخفضا العشوائية**: بلا سرّ يكشفهما
# جدول قوس قزح من الهاش في دقائق.
#
# **لا يُشتقّ من SUPABASE_SERVICE_ROLE_KEY**: خلط الأسرار يجعل تدوير أحدهما
# يكسر الآخر صامتًا، وتسريب أحدهما يفضح الاثنين.
#
# 32 بايتًا على الأقل:  openssl rand -hex 32
RATE_LIMIT_HMAC_SECRET=

# عدد الوكلاء الموثوقين أمام التطبيق — يُستعمل مع x-forwarded-for وحدها
# حين تغيب x-real-ip. Railway وحده = 1 · Cloudflare أمامه = 2
# YSD_TRUSTED_PROXY_HOPS=1

# Groq — مزوّد احتياطي (v0.9.0). اتركه فارغًا ليبقى الاحتياط معطّلًا.
# خادمي فقط: لا تستعمل بادئة NEXT_PUBLIC_ إطلاقًا.
GROQ_API_KEY=

# ─────────────────────────────────────────────────────────────
#  YSD Model Runtime — مغلق افتراضيًا (v0.9.3)
# ─────────────────────────────────────────────────────────────
#
# عَلَمان منفصلان عمدًا، ولا يفتح أحدهما الآخر:
#
#   YSD_PROVIDER_ENABLED  → يُظهر مزوّد YSD في السجلّ الداخلي.
#   YSD_RUNTIME_ENABLED   → يسمح بالاتصال بوقت التشغيل.
#
# فقد نريد المزوّد ظاهرًا للإدارة بلا وقت تشغيل خلفه، والعكس أثناء
# التجهيز. وربطُهما كان سيجعل فتح أحدهما يفتح الآخر بلا قصد.
#
# ولا تكفي هذه القيم وحدها لتشغيل النموذج: يلزم فوق ذلك نشرة نشطة
# ونسخة معتمدة في سجلّ النماذج، ونموذج مفعَّل في ai_models.
#
# ★ وYSD_PROVIDER_ENABLED وحده **لا يجعل المزوّد جاهزًا** (v0.9.3):
#   isConfigured() تشترط ثلاثة معًا —
#     (١) YSD_PROVIDER_ENABLED=1
#     (٢) إعداد وقت تشغيل صالح (القيم الأربع أدناه)
#     (٣) صلاحية سجلّ: NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#   فالعَلَم بوابة لا إعلانُ جاهزية: لولا ذلك لَوصل الطلب إلى مزوّد لا
#   يستطيع خدمته، فيظهر العطل عند المستخدم بدل أن يُمنع الطلب أصلًا.
#
# كلها **خادمية**: لا تستعمل بادئة NEXT_PUBLIC_ لأيٍّ منها إطلاقًا.
# ولا تضع قيمًا حقيقية في Git.
YSD_PROVIDER_ENABLED=0
YSD_RUNTIME_ENABLED=0

# البيئة المستهدفة — واحدة من: development | staging | production
# تُطابَق مع ai_model_deployments.environment قبل أي نداء.
YSD_DEPLOYMENT_ENVIRONMENT=

# اسم مستعار **فقط** — ليس عنوانًا ولا مسارًا.
# يُطابَق مع ai_model_deployments.endpoint_alias، ولا يُبنى منه أي URL.
# المسموح: حروف وأرقام ونقطة وشرطة وشرطة سفلية. مثال: ysd-inference-primary
YSD_RUNTIME_ENDPOINT_ALIAS=

# جذر الواجهة المتوافقة مع OpenAI — مثال: https://runtime.internal/v1
# العنوان يأتي من هنا **وحده**، فلا تستطيع القاعدة توجيه الخادم لأي مضيف.
# بلا اسم مستخدم/كلمة مرور، وبلا query، وبلا hash.
YSD_RUNTIME_BASE_URL=

# مفتاح وقت التشغيل — خادمي بحت، لا يُطبع ولا يُسجَّل ولا يصل المتصفح.
YSD_RUNTIME_API_KEY=
