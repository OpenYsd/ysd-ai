# ============================================================
# YSD AI — ما لا يدخل سياق البناء إطلاقًا
# القاعدة: كل ما هنا لا يصل daemon البناء أصلًا، فلا يمكن أن يتسرّب إلى أي طبقة
# ولو بـ COPY . . — وهذا خط الدفاع الأول عن الأسرار.
# ============================================================

# ---------- أسرار ----------
.env
.env.*
!.env.example
# قوالب/ملفات بيئة بأي تسمية (env.production, env.prod …) — القالب لا يحوي أسرارًا
# لكن ملفًا مُعبّأً بنفس التسمية سيحويها، فنُخرج النمط كله من سياق البناء.
env.*
*.pem
*.key

# ---------- ملفات QA السرّية/المؤقتة ----------
scripts/.qa-*
scripts/.tmp-*
scripts/.fixtures/
public/qa-*

# ---------- اعتماديات ومخرجات تُبنى داخل الصورة ----------
node_modules
.next
out
build
dist
tsconfig.tsbuildinfo

# ---------- git والتطوير ----------
.git
.gitignore
.github
.vscode
.idea
.claude

# ---------- اختبارات وأدوات لا يحتاجها الإنتاج ----------
tests
playwright-report
test-results
playwright.config.*
vitest.config.*
coverage

# ---------- توثيق ----------
docs
*.md
!README.md

# ---------- مخلفات اختبار حسّاسة ----------
# .playwright/.auth يحمل حالة جلسة حساب E2E (كوكيز مصادقة). الـDockerfile
# ينفّذ COPY . . فبدون هذا السطر تدخل الجلسة الصورة — سرّ فعلي لا مجرد مخلّف.
.playwright/
playwright-report/
test-results/
blob-report/

# ---------- سجلات ومخلفات ----------
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.cache
Dockerfile
.dockerignore
