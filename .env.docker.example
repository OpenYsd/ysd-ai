# ============================================================
# YSD AI — قالب متغيرات النشر (أسماء فقط — لا تضع أي قيمة هنا)
# انسخه إلى ملف خارج المستودع واملأه في منصة النشر أو عبر -e.
# ملف .env* كله مُستبعَد في .dockerignore فلا يدخل الصورة إطلاقًا.
# ============================================================

# ---------- (أ) وقت البناء **و** وقت التشغيل ----------
# تلزم مرّتين — وهذا مصدر خطأ شائع:
#   • build arg → تُحقَن في حزمة المتصفح.
#   • -e وقت التشغيل → لأن lib/env.ts يقرأ process.env[name] ديناميكيًا، وNext.js
#     لا يحقن إلا الوصول الساكن. بدونها يُرفض الإقلاع مع YSD_STRICT_ENV=1
#     وترد كل المسارات 500.
# عامة بطبيعتها: تصل كل زائر أصلًا. لا تضع أي سرّ خادمي هنا.
#   docker build --build-arg NEXT_PUBLIC_SUPABASE_URL=... \
#                --build-arg NEXT_PUBLIC_SUPABASE_ANON_KEY=... -t ysd-ai .
#   docker run -e NEXT_PUBLIC_SUPABASE_URL=... -e NEXT_PUBLIC_SUPABASE_ANON_KEY=... ...
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_DEFAULT_LOCALE=

# ---------- (ب) وقت التشغيل — إلزامية ----------
# أسرار خادمية: -e أو secrets المنصة فقط. لا build-arg (يبقى في تاريخ الطبقات).
OPENROUTER_API_KEY=

# Browser Assistant fail-closed production controls. Do not enable until the
# readiness gate is green; secrets are runtime-only and never build args.
YSD_BROWSER_ASSISTANT_ENABLED=0
YSD_DEPLOYMENT_ENVIRONMENT=production
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_HMAC_SECRET=
YSD_BROWSER_TOKEN_SECRET=
YSD_BROWSER_PROVIDER=openrouter
YSD_BROWSER_MODEL_ID=ysd/free

# ---------- (ج) وقت التشغيل — اختيارية ----------
ANTHROPIC_API_KEY=
YSD_APP_URL=

# رفض الإقلاع إن نقص متغير إلزامي — يُنصح به في الإنتاج
YSD_STRICT_ENV=

# مضبوط على 1 في الصورة (قالب النشر المبدئي) — يقلّل بصمة نموذج Embeddings
YSD_LOW_MEMORY=

# ---------- (د) لا تُستخدم في الإنتاج ----------
# SUPABASE_SERVICE_ROLE_KEY — لا يلزم إذا بقي Browser Assistant مغلقًا؛ يلزم
#   خادميًا فقط عند تفعيله لمخزن Device Auth وحدّ المعدّل الموزّع.
# YSD_OWNER_EMAIL / YSD_OWNER_PASSWORD — سكربتات QA محليًا فقط. لا تدخل الإنتاج.
